# Porta HTTP da API
PORT=3030

# Postgres do Supabase (HOMOLOGAÇÃO durante o desenvolvimento: projeto ltixkslqlreybdhutpbr).
# Em produção use o role restrito `easymenu_api` (deploy/role-e-grants.sql), nunca o postgres.
DATABASE_URL=postgresql://USUARIO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# false só para Postgres local sem SSL (desenvolvimento/teste). O Supabase exige SSL.
DATABASE_SSL=true
# false só em desenvolvimento: o certificado do pooler não está na cadeia padrão do Node.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Assina o token que vai dentro do QR code da mesa. Mínimo 32 caracteres.
# Trocar este valor invalida TODOS os QR codes já impressos.
QR_TOKEN_SECRET=

# Chave do painel /admin/qrcodes (gerar QR codes das mesas). Mínimo 24 caracteres.
ADMIN_API_KEY=

# Endereço público do front — é o link que vai dentro do QR code.
PUBLIC_APP_URL=http://localhost:3000

# Origens do navegador aceitas (separadas por vírgula). Vazio = só chamadas sem CORS (via proxy do Next).
CORS_ORIGINS=

# Quantos proxies confiáveis existem na frente (Caddy = 1). Afeta o IP usado no limite de requisições.
TRUST_PROXY=0

# Push do app do garçom (pedido pronto com o celular bloqueado). Opcional: as três ou nenhuma.
# Gerar o par: npx web-push generate-vapid-keys   (trocar as chaves desinscreve todos os celulares)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelos serviços de push (https://... ou mailto:...)
VAPID_SUBJECT=
