{
  "name": "easymenu-api",
  "version": "1.0.0",
  "private": true,
  "description": "API do cardápio digital da mesa (EasyMenu): grava os pedidos nas comandas do EasyFood no Supabase.",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrar": "node scripts/migrar.mjs",
    "implantacao:gerar": "node scripts/juntar-migracoes.mjs"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/throttler": "^6.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.3",
    "@swc/core": "^1.15.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "3.6.4",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "supertest": "^7.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^5.1.0"
  }
}
